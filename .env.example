APP_NAME=Runbook
ENVIRONMENT=development
LOG_LEVEL=INFO
API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
LOCAL_REPO_MOUNT=/workspace/local_repos

GRAPH_BACKEND=arcadedb
ARCADEDB_HOST=arcadedb
ARCADEDB_PORT=2480
ARCADEDB_USER=root
ARCADEDB_PASSWORD=runbook_dev_password
ARCADEDB_DATABASE=runbook

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/github/callback
GITHUB_TOKEN=

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:8000/api/auth/slack/callback
SLACK_BOT_TOKEN=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
NEXTAUTH_SECRET=
JWT_SECRET=replace-with-a-long-random-secret
APP_BASE_URL=http://localhost:3000
AUTH_DEV_MODE=true

# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATION_ENCRYPTION_KEY=
RUNBOOK_DEMO_MODE=false
ALLOW_LOCAL_COMMAND_EXECUTION=false

# Incident-tool importers (migration layer). Leave empty to keep importers
# honestly reporting "not_connected".
PAGERDUTY_API_TOKEN=
ROOTLY_API_TOKEN=
INCIDENT_IO_API_TOKEN=
OPSGENIE_API_TOKEN=
STATUSPAGE_API_TOKEN=
JSM_API_TOKEN=
SERVICENOW_API_TOKEN=
